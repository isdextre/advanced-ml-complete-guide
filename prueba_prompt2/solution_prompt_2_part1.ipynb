 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Análisis Completo de Estructura de Datos - Customer Churn\n",
    "## Prompt 2 - Parte 1: Exploración y Diagnóstico\n",
    "\n",
    "Este notebook realiza un análisis exhaustivo de la estructura de datos de churn de clientes bancarios."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. CARGA Y EXPLORACIÓN INICIAL"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Importar librerías necesarias\n",
    "import json\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy import stats\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Configurar visualización\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "sns.set_palette('husl')\n",
    "%matplotlib inline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cargar datos desde JSON\n",
    "print(\"Cargando datos...\")\n",
    "with open('/mnt/user-data/uploads/advanced-ml-complete-guide/prueba_prompt2/customer_churn_data.json', 'r') as f:\n",
    "    data = json.load(f)\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "print(\"✓ Datos cargados exitosamente\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Shape del dataset\n",
    "print(f\"Shape del dataset: {df.shape}\")\n",
    "print(f\"\\nNúmero de filas: {df.shape[0]:,}\")\n",
    "print(f\"Número de columnas: {df.shape[1]}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Info del dataset\n",
    "print(\"INFORMACIÓN DEL DATASET:\")\n",
    "print(\"=\"*80)\n",
    "df.info()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Primeras filas\n",
    "print(\"\\nPRIMERAS 5 FILAS:\")\n",
    "print(\"=\"*80)\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Tipos de datos resumido\n",
    "print(\"\\nRESUMEN DE TIPOS DE DATOS:\")\n",
    "print(\"=\"*80)\n",
    "dtype_summary = df.dtypes.value_counts()\n",
    "print(dtype_summary)\n",
    "print(f\"\\nTotal de columnas numéricas: {(df.dtypes != 'object').sum()}\")\n",
    "print(f\"Total de columnas categóricas: {(df.dtypes == 'object').sum()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. MISSINGNESS - Análisis de Valores Nulos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calcular nulos por feature\n",
    "missing_data = pd.DataFrame({\n",
    "    'Feature': df.columns,\n",
    "    'Missing_Count': df.isnull().sum().values,\n",
    "    'Missing_Percentage': (df.isnull().sum().values / len(df) * 100)\n",
    "})\n",
    "\n",
    "missing_data = missing_data[missing_data['Missing_Count'] > 0].sort_values('Missing_Percentage', ascending=False)\n",
    "\n",
    "print(\"NULOS POR FEATURE:\")\n",
    "print(\"=\"*80)\n",
    "if len(missing_data) > 0:\n",
    "    print(missing_data.to_string(index=False))\n",
    "else:\n",
    "    print(\"No hay valores nulos en el dataset\")\n",
    "\n",
    "print(f\"\\nTotal de nulos: {df.isnull().sum().sum()}\")\n",
    "print(f\"Porcentaje de nulos: {(df.isnull().sum().sum() / (df.shape[0] * df.shape[1]) * 100):.4f}%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlación de nulos con churn (si existen nulos)\n",
    "if df.isnull().sum().sum() > 0:\n",
    "    print(\"\\nCORRELACIÓN DE NULOS CON CHURN:\")\n",
    "    print(\"=\"*80)\n",
    "    \n",
    "    # Crear variable binaria para nulos\n",
    "    nulls_per_row = df.isnull().sum(axis=1)\n",
    "    \n",
    "    # Chi-square test por cada feature con nulos\n",
    "    for col in df.columns:\n",
    "        if df[col].isnull().sum() > 0 and col != 'churn_90d':\n",
    "            crosstab = pd.crosstab(df[col].isnull(), df['churn_90d'])\n",
    "            chi2, p_value, dof, expected = stats.chi2_contingency(crosstab)\n",
    "            print(f\"{col}: χ² = {chi2:.4f}, p-value = {p_value:.4f}\")\nelse:\n",
    "    print(\"\\nNo hay nulos para analizar correlación con churn\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Mapa de nulos (si existen)\n",
    "if df.isnull().sum().sum() > 0:\n",
    "    plt.figure(figsize=(14, 8))\n",
    "    sns.heatmap(df.isnull(), cbar=True, yticklabels=False, cmap='viridis')\n",
    "    plt.title('Mapa de Valores Nulos', fontsize=14, fontweight='bold')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\nelse:\n",
    "    print(\"No hay valores nulos para visualizar\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. DISTRIBUCIONES DEL TARGET - Churn"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Distribución de churn\n",
    "print(\"DISTRIBUCIÓN DEL TARGET (churn_90d):\")\n",
    "print(\"=\"*80)\n",
    "churn_dist = df['churn_90d'].value_counts()\n",
    "churn_pct = df['churn_90d'].value_counts(normalize=True) * 100\n",
    "\n",
    "churn_summary = pd.DataFrame({\n",
    "    'Churn': ['No Churn (0)', 'Churn (1)'],\n",
    "    'Count': churn_dist.values,\n",
    "    'Percentage': churn_pct.values\n",
    "})\n",
    "\n",
    "print(churn_summary.to_string(index=False))\nprint(f\"\\nRatio de desbalance: {churn_dist[0]/churn_dist[1]:.2f}:1\")\nprint(f\"Clase minoritaria: {(churn_dist[1]/len(df)*100):.2f}% del dataset\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Gráfico de proporciones\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "# Gráfico de barras\n",
    "colors = ['#2ecc71', '#e74c3c']\n",
    "axes[0].bar(['No Churn', 'Churn'], churn_dist.values, color=colors)\n",
    "axes[0].set_title('Distribución de Churn (Absoluto)', fontsize=12, fontweight='bold')\n",
    "axes[0].set_ylabel('Cantidad')\n",
    "for i, v in enumerate(churn_dist.values):\n",
    "    axes[0].text(i, v + 50, str(v), ha='center', fontweight='bold')\n",
    "\n",
    "# Gráfico de pie\n",
    "axes[1].pie(churn_dist.values, labels=['No Churn', 'Churn'], autopct='%1.1f%%', colors=colors, startangle=90)\n",
    "axes[1].set_title('Distribución de Churn (Porcentaje)', fontsize=12, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. DISTRIBUCIONES DE FEATURES - Análisis Univariado"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Separar features numéricas y categóricas\n",
    "numeric_features = df.select_dtypes(include=[np.number]).columns.tolist()\n",
    "categorical_features = df.select_dtypes(include=['object']).columns.tolist()\n",
    "\n",
    "# Remover target de features\n",
    "if 'churn_90d' in numeric_features:\n",
    "    numeric_features.remove('churn_90d')\n",
    "if 'churn_90d' in categorical_features:\n",
    "    categorical_features.remove('churn_90d')\n",
    "\n",
    "print(f\"Features numéricas: {len(numeric_features)}\")\n",
    "print(f\"Features categóricas: {len(categorical_features)}\")\n",
    "print(f\"\\nPrimeras numéricas: {numeric_features[:10]}\")\nprint(f\"Primeras categóricas: {categorical_features[:5]}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Histogramas de features numéricas (muestra)\n",
    "sample_numeric = numeric_features[:12]\n",
    "fig, axes = plt.subplots(4, 3, figsize=(15, 12))\n",
    "axes = axes.ravel()\n",
    "\n",
    "for idx, feature in enumerate(sample_numeric):\n",
    "    axes[idx].hist(df[feature].dropna(), bins=30, color='skyblue', edgecolor='black', alpha=0.7)\n",
    "    axes[idx].set_title(f'{feature}', fontsize=10, fontweight='bold')\n",
    "    axes[idx].set_ylabel('Frecuencia')\n",
    "    axes[idx].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.suptitle('Distribuciones de Features Numéricas (Muestra)', fontsize=14, fontweight='bold', y=1.00)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Boxplots para detectar outliers (muestra)\n",
    "fig, axes = plt.subplots(4, 3, figsize=(15, 12))\n",
    "axes = axes.ravel()\n",
    "\n",
    "for idx, feature in enumerate(sample_numeric):\n",
    "    axes[idx].boxplot(df[feature].dropna(), vert=True)\n",
    "    axes[idx].set_title(f'{feature}', fontsize=10, fontweight='bold')\n",
    "    axes[idx].set_ylabel('Valor')\n",
    "    axes[idx].grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.suptitle('Boxplots de Features Numéricas (Muestra)', fontsize=14, fontweight='bold', y=1.00)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Detectar features con ruido puro o varianza muy baja\n",
    "print(\"\\nANÁLISIS DE VARIANZA Y RUIDO:\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "variance_analysis = []\n",
    "for feature in numeric_features:\n",
    "    var = df[feature].var()\n",
    "    std = df[feature].std()\n",
    "    mean = df[feature].mean()\n",
    "    cv = std / abs(mean) if mean != 0 else np.inf  # Coeficiente de variación\n",
    "    \n",
    "    # Contar valores únicos\n",
    "    unique_count = df[feature].nunique()\n",
    "    unique_pct = unique_count / len(df) * 100\n",
    "    \n",
    "    variance_analysis.append({\n",
    "        'Feature': feature,\n",
    "        'Variance': var,\n",
    "        'Std': std,\n",
    "        'CV': cv,\n",
    "        'Unique_Values': unique_count,\n",
    "        'Unique_Pct': unique_pct\n",
    "    })\n",
    "\n",
    "var_df = pd.DataFrame(variance_analysis).sort_values('Variance')\n",
    "\n",
    "# Features con varianza muy baja (potencial ruido)\n",
    "low_var_features = var_df[var_df['Variance'] < 0.01]\nprint(f\"\\nFeatures con varianza MUY BAJA (<0.01): {len(low_var_features)}\")\nif len(low_var_features) > 0:\n",
    "    print(low_var_features.head(10).to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Features que parecen ruido puro (muy pocas valores únicos)\n",
    "print(\"\\nFeatures con MUY POCOS valores únicos (potencial ruido):\")\nlow_unique = var_df[var_df['Unique_Values'] <= 10].sort_values('Unique_Values')\nif len(low_unique) > 0:\n",
    "    print(low_unique[['Feature', 'Unique_Values', 'Unique_Pct']].to_string(index=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. CORRELACIONES - Análisis de Relaciones Lineales"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlación con el target (churn)\n",
    "print(\"\\nCORRELACIÓN CON CHURN:\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "correlations = df[numeric_features + ['churn_90d']].corr()['churn_90d'].drop('churn_90d').sort_values(key=abs, ascending=False)\n",
    "\n",
    "print(\"\\nTop 20 Features con mayor correlación con churn:\")\nprint(correlations.head(20).to_string())\n",
    "\n",
    "print(\"\\nFeatures con correlación muy baja (<0.05) con churn:\")\nlow_corr = correlations[abs(correlations) < 0.05]\nprint(f\"Cantidad: {len(low_corr)}\")\nif len(low_corr) > 0:\n",
    "    print(low_corr.head(20).to_string())"
   ]
  },
  {
   "cell_type": "code">
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Heatmap de correlaciones (muestra)\n",
    "top_features_corr = abs(correlations).head(15).index.tolist()\n",
    "corr_matrix = df[top_features_corr + ['churn_90d']].corr()\n",
    "\n",
    "plt.figure(figsize=(12, 10))\n",
    "sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', center=0, fmt='.2f', \n",
    "            square=True, linewidths=1, cbar_kws={\"shrink\": 0.8})\n",
    "plt.title('Matriz de Correlaciones - Top Features vs Churn', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Detectar colinealidad (features casi idénticas)\n",
    "print(\"\\nDETECCIÓN DE COLINEALIDAD:\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "full_corr_matrix = df[numeric_features].corr().abs()\n",
    "\n",
    "# Encontrar pares altamente correlacionados\n",
    "collinear_pairs = []\n",
    "for i in range(len(full_corr_matrix.columns)):\n",
    "    for j in range(i+1, len(full_corr_matrix.columns)):\n",
    "        if full_corr_matrix.iloc[i, j] > 0.95:  # Umbral de colinealidad muy alta\n",
    "            collinear_pairs.append({\n",
    "                'Feature1': full_corr_matrix.columns[i],\n",
    "                'Feature2': full_corr_matrix.columns[j],\n",
    "                'Correlation': full_corr_matrix.iloc[i, j]\n",
    "            })\n",
    "\n",
    "if collinear_pairs:\n",
    "    collinear_df = pd.DataFrame(collinear_pairs).sort_values('Correlation', ascending=False)\n",
    "    print(f\"\\nPares de features altamente colineales (|r| > 0.95): {len(collinear_df)}\")\n",
    "    print(collinear_df.to_string(index=False))\nelse:\n",
    "    print(\"\\nNo se encontraron features altamente colineales (|r| > 0.95)\")\n",
    "\n",
    "# Moderada colinealidad\n",
    "moderate_collinear = []\n",
    "for i in range(len(full_corr_matrix.columns)):\n",
    "    for j in range(i+1, len(full_corr_matrix.columns)):\n",
    "        if 0.85 <= full_corr_matrix.iloc[i, j] <= 0.95:\n",
    "            moderate_collinear.append({\n",
    "                'Feature1': full_corr_matrix.columns[i],\n",
    "                'Feature2': full_corr_matrix.columns[j],\n",
    "                'Correlation': full_corr_matrix.iloc[i, j]\n",
    "            })\n",
    "\n",
    "print(f\"\\nPares con moderada colinealidad (0.85 < |r| <= 0.95): {len(moderate_collinear)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. OUTLIERS - Análisis de Valores Extremos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Método IQR para detectar outliers\n",
    "print(\"DETECCIÓN DE OUTLIERS (Método IQR):\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "outlier_summary = []\n",
    "for feature in numeric_features:\n",
    "    Q1 = df[feature].quantile(0.25)\n",
    "    Q3 = df[feature].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower_bound = Q1 - 1.5 * IQR\n",
    "    upper_bound = Q3 + 1.5 * IQR\n",
    "    \n",
    "    outliers = df[(df[feature] < lower_bound) | (df[feature] > upper_bound)][feature]\n",
    "    outlier_pct = len(outliers) / len(df) * 100\n",
    "    \n",
    "    if len(outliers) > 0:\n",
    "        outlier_summary.append({\n",
    "            'Feature': feature,\n",
    "            'Outlier_Count': len(outliers),\n",
    "            'Outlier_Pct': outlier_pct,\n",
    "            'Lower_Bound': lower_bound,\n",
    "            'Upper_Bound': upper_bound,\n",
    "            'Min_Value': outliers.min(),\n",
    "            'Max_Value': outliers.max()\n",
    "        })\n",
    "\n",
    "if outlier_summary:\n",
    "    outlier_df = pd.DataFrame(outlier_summary).sort_values('Outlier_Pct', ascending=False)\n",
    "    print(f\"\\nFeatures con outliers: {len(outlier_df)}\")\n",
    "    print(outlier_df[['Feature', 'Outlier_Count', 'Outlier_Pct']].to_string(index=False))\n",
    "    \n",
    "    print(\"\\nTop 10 Features con mayor % de outliers:\")\n",
    "    print(outlier_df[['Feature', 'Outlier_Pct', 'Min_Value', 'Max_Value']].head(10).to_string(index=False))\nelse:\n",
    "    print(\"\\nNo se detectaron outliers significativos\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizar outliers extremos (muestra)\n",
    "if outlier_summary:\n",
    "    top_outlier_features = outlier_df.head(6)['Feature'].tolist()\n",
    "    \n",
    "    fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n",
    "    axes = axes.ravel()\n",
    "    \n",
    "    for idx, feature in enumerate(top_outlier_features):\n",
    "        axes[idx].hist(df[feature].dropna(), bins=30, color='skyblue', edgecolor='black', alpha=0.7)\n",
    "        axes[idx].set_title(f'{feature}\\n(Outliers: {outlier_df[outlier_df[\"Feature\"]==feature][\"Outlier_Count\"].values[0]})', \n",
    "                           fontsize=10, fontweight='bold')\n",
    "        axes[idx].set_ylabel('Frecuencia')\n",
    "        axes[idx].grid(True, alpha=0.3)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.suptitle('Features con Más Outliers', fontsize=14, fontweight='bold', y=1.00)\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. RESUMEN DIAGNÓSTICO FINAL"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generar resumen diagnóstico\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"RESUMEN DIAGNÓSTICO FINAL\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "print(\"\\n1. CARACTERÍSTICAS DEL DATASET:\")\n",
    "print(f\"   - Muestras: {df.shape[0]:,}\")\n",
    "print(f\"   - Features: {df.shape[1]}\")\n",
    "print(f\"   - Target: churn_90d (binario)\")\n",
    "print(f\"   - Desbalance: {(churn_dist[1]/churn_dist[0])*100:.2f}% churn vs {(churn_dist[0]/churn_dist[1])*100:.2f}% no-churn\")\n",
    "\n",
    "print(\"\\n2. PROBLEMAS IDENTIFICADOS:\")\n",
    "issues = []\n",
    "\n",
    "# Nulos\n",
    "if df.isnull().sum().sum() > 0:\n",
    "    issues.append(f\"✗ Valores nulos: {df.isnull().sum().sum()} detectados\")\nelse:\n",
    "    issues.append(\"✓ Sin valores nulos\")\n",
    "\n",
    "# Varianza baja\n",
    "if len(low_var_features) > 0:\n",
    "    issues.append(f\"✗ Varianza muy baja: {len(low_var_features)} features con var < 0.01\")\n",
    "\n",
    "# Colinealidad\n",
    "if collinear_pairs:\n",
    "    issues.append(f\"✗ Colinealidad alta: {len(collinear_df)} pares de features |r| > 0.95\")\nelse:\n",
    "    issues.append(\"✓ No hay colinealidad extrema\")\n",
    "\n",
    "# Outliers\n",
    "if outlier_summary:\n",
    "    max_outlier_pct = outlier_df['Outlier_Pct'].max()\n",
    "    if max_outlier_pct > 5:\n",
